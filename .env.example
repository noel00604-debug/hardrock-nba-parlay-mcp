# hardrock-nba-parlay-mcp configuration. Copy to ~/.hardrock-nba-parlay/.env (chmod 600) or ./.env.
# Every variable is optional unless stated; defaults are in src/hardrock_nba_parlay/config.py.
# NEVER commit a filled-in copy. Values are intentionally blank here.

# --- identity and storage -------------------------------------------------------------
# Application name reported by get_system_status (default hardrock-nba-parlay-mcp).
HRNBA_APP_NAME=
# Version string override; normally read from package metadata. Leave blank.
HRNBA_VERSION=
# Directory for the SQLite fallback database and local files (default ~/.hardrock-nba-parlay).
HRNBA_DATA_DIR=
# SQLAlchemy URL. Blank = sqlite in HRNBA_DATA_DIR. Hosted: postgresql+psycopg://user:pass@host:5432/db
HRNBA_DATABASE_URL=
# Display time zone for ET rendering (default America/New_York).
HRNBA_DISPLAY_TZ=
# User id used ONLY when HRNBA_AUTH_MODE=none (stdio / CLI). Default local-owner.
HRNBA_LOCAL_USER_ID=
# Data mode: live (default) or fixture. fixture = offline demo slate clearly labelled FIXTURE that never
# writes to a real ledger. Never set fixture in production or on the hosted server.
HRNBA_DATA_MODE=

# --- hosted mode ----------------------------------------------------------------------
# none (stdio/CLI) | builtin_oauth (hosted, built-in OAuth 2.0 authorization server) | external_jwt
HRNBA_AUTH_MODE=
# https base URL of the hosted server, e.g. https://your-host.example; /mcp is the resource. Required when hosted.
HRNBA_PUBLIC_URL=
# Cookie/session signing and per-user provider-key encryption. 64 random hex chars. Required when hosted.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
HRNBA_SECRET_KEY=
# Bind address and port for the HTTP transport (defaults 127.0.0.1 and 8000; the Docker image uses 0.0.0.0:8080).
HRNBA_HOST=
HRNBA_PORT=
# Logging level (default INFO). Logs are redacted of apiKey, Bearer, token, client_secret, password values.
HRNBA_LOG_LEVEL=
# Streamable HTTP: answer each POST with a single JSON body instead of SSE (default false). Needed behind a
# Cloudflare Quick Tunnel, which cannot stream SSE.
HRNBA_HTTP_JSON_RESPONSE=

# --- data providers -------------------------------------------------------------------
# The Odds API key (40 characters). Server-wide key; per-user keys set through set_user_settings override it.
# Alternatively store it in the macOS keychain: security add-generic-password -s hardrock-nba-parlay -a ODDS_API_KEY -w
HRNBA_ODDS_API_KEY=
# The Odds API base URL (default https://api.the-odds-api.com/v4).
HRNBA_ODDS_API_BASE_URL=
# Target bookmaker key and jurisdiction (defaults hardrockbet_fl and US-FL). Never substitute hardrockbet.
HRNBA_TARGET_BOOK=
HRNBA_TARGET_JURISDICTION=
# Reference books as JSON lists (defaults ["pinnacle"] and ["pinnacle","draftkings","fanduel"]).
HRNBA_REFERENCE_BOOKS=
HRNBA_PROP_REFERENCE_BOOKS=

# --- budget and freshness -------------------------------------------------------------
# Default daily gross stake cap in USD for new users (default 10.00). Per-user caps live in user_settings.
HRNBA_DAILY_CAP_USD_DEFAULT=
# Maximum odds age in seconds, source timestamp to now (default 180).
HRNBA_MAX_ODDS_AGE_SECONDS=
# Maximum reference-vs-target timestamp skew in seconds (default 60).
HRNBA_MAX_REFERENCE_SKEW_SECONDS=
# Maximum age of the injury report in seconds (default 21600 = 6 hours).
HRNBA_INJURY_REPORT_MAX_AGE_SECONDS=
# Budget reservation time-to-live in seconds (default 7200 = 2 hours; also capped at the earliest tip-off).
HRNBA_RESERVATION_TTL_SECONDS=

# --- HTTP client and provider limits --------------------------------------------------
# Provider HTTP timeout in seconds (default 15.0) and bounded retries on 429/5xx (default 3).
HRNBA_HTTP_TIMEOUT_SECONDS=
HRNBA_HTTP_MAX_RETRIES=
# In-process provider cache TTL in seconds (default 60).
HRNBA_PROVIDER_CACHE_TTL_SECONDS=
# App-wide guard on The Odds API credits per ET day (default 25, sized for the free Starter plan's
# roughly 16 credits per day). Set to about 200 on the 20K plan for the full daily routine. PROVIDER_CREDIT_GUARD when reached.
HRNBA_DAILY_PROVIDER_CREDIT_BUDGET=
# Hosted mode: maximum provider credits one user may consume per ET day on the server-wide key (default 30).
HRNBA_PER_USER_DAILY_CREDIT_QUOTA=
# Fetch the official NBA injury-report PDF automatically (default true); manual entry always remains available.
HRNBA_INJURY_AUTO_FETCH=

# --- review window --------------------------------------------------------------------
# First 30-day review window, ISO dates (defaults 2026-10-20 and 2026-11-18).
HRNBA_REVIEW_WINDOW_START=
HRNBA_REVIEW_WINDOW_END=

# --- tests only -----------------------------------------------------------------------
# true permits FIXTURE-mode records in the ledger. Never set in production.
HRNBA_ALLOW_FIXTURE_LEDGER=
